rules_version = '2';

// AppNutri — regras de segurança do Firestore.
// Não publicar estas regras sem executar os testes do emulador primeiro.

service cloud.firestore {
  match /databases/{database}/documents {

    function isNutri() {
      return request.auth != null
        && request.auth.uid == "Tzcb9pugJvN57n5YI1TUQ5zRu4h1";
    }

    function cli(id) {
      return get(/databases/$(database)/documents/clientes/$(id)).data;
    }

    function isDono(id) {
      return request.auth != null
        && cli(id).authUid == request.auth.uid
        && cli(id).ativo == true;
    }

    function consentOk(id) {
      let p = /databases/$(database)/documents/clientes/$(id)/consentimentos/v1;
      return exists(p) && get(p).data.revogadoEm == null;
    }

    // Configuração privada da nutricionista.
    match /config/nutricionista {
      allow read, write: if isNutri();
    }

    // Biblioteca privada de modelos de cardápio.
    match /config/modelosCardapio/itens/{modeloId} {
      allow read, write: if isNutri();
    }

    // Catálogo de alimentos e receitas: acesso exclusivo da nutricionista.
    // Estas regras cobrem também eventuais subcoleções dessas coleções.
    match /alimentos/{document=**} {
      allow read, write: if isNutri();
    }

    match /receitas/{document=**} {
      allow read, write: if isNutri();
    }

    match /clientes/{id} {
      // Cadastro: nutricionista ou o próprio cliente ativo.
      allow get: if isNutri() || isDono(id);

      // Consultas de coleção devem respeitar a identidade do cliente.
      allow list: if isNutri()
        || (request.auth != null
            && resource.data.authUid == request.auth.uid
            && resource.data.ativo == true);

      allow create, delete: if isNutri();

      // A nutricionista só pode alterar campos administrativos conhecidos.
      // Campos clínicos e outros dados não podem ser sobrescritos por engano.
      allow update: if (
        isNutri()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'dataNascimento',
          'contato',
          'objetivo',
          'authUid',
          'ativo',
          'statusAcompanhamento',
          'statusAtualizadoEm',
          'arquivadoEm',
          'cardapioVigenteId',
          'acompanhaDiario',
          'primeiroAcessoConcluido'
        ])
      ) || (
        isDono(id)
        && consentOk(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'dataNascimento',
          'contato',
          'acompanhaDiario',
          'primeiroAcessoConcluido'
        ])
      );

      match /anamneseInicial/{docId} {
        allow read: if isNutri() || isDono(id);

        allow create: if isDono(id) && consentOk(id)
          && request.resource.data.status in ['rascunho', 'enviada'];

        allow update: if
          (isNutri() && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'revisadaEm']))
          || (isDono(id) && consentOk(id)
              && resource.data.status != 'revisada'
              && request.resource.data.status in ['rascunho', 'enviada']);

        allow delete: if false;
      }

      // Anotações profissionais: exclusivas da nutricionista.
      match /observacoesNutri/{observacaoId} {
        allow read, write: if isNutri();
      }

      // Sessões clínicas: exclusivas da nutricionista.
      match /sessoes/{sessaoId} {
        allow read, write: if isNutri();
      }

      // Cardápios:
      // - cliente lê somente versões publicadas (vigentes ou encerradas);
      // - rascunhos ficam privados;
      // - rascunhos podem ser editados pela nutricionista;
      // - uma versão publicada só pode mudar de vigente para encerrado;
      // - versões publicadas não podem ser apagadas.
      match /cardapios/{cardapioId} {
        allow read: if isNutri()
          || (isDono(id)
              && resource.data.status in ['vigente', 'encerrado']);

        allow create: if isNutri()
          && request.resource.data.status in ['rascunho', 'vigente'];

        allow update: if isNutri() && (
          (resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'vigente'])
          ||
          (resource.data.status == 'vigente'
            && request.resource.data.status == 'encerrado'
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['status']))
        );

        allow delete: if isNutri()
          && resource.data.status == 'rascunho';
      }

      // Check-ins: o próprio cliente ativo, com consentimento e recurso habilitado.
      match /checkins/{data} {
        allow read: if isNutri() || isDono(id);
        allow create, update: if isDono(id) && consentOk(id)
          && cli(id).acompanhaDiario == true;
        allow delete: if false;
      }

      // Consentimento: o cliente pode registrar e revogar, não apagar o histórico.
      match /consentimentos/{consentId} {
        allow read: if isNutri() || isDono(id);
        allow create: if isDono(id)
          && request.resource.data.revogadoEm == null;
        allow update: if isDono(id)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['revogadoEm']);
        allow delete: if false;
      }

      // Auditoria: imutável depois de criada.
      match /auditLog/{logId} {
        allow read: if isNutri();
        allow create: if isNutri() || isDono(id);
        allow update, delete: if false;
      }
    }
  }
}
